# Express server
PORT=3000

# PostgreSQL via discrete vars
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE=univet_db

# Or use a full connection string instead of the above
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/univet_db
# DATABASE_SSL=false

# JWT (obrigatório: sem ele o login retorna 500)
SECRETKEY=troque_por_uma_chave_longa_e_aleatoria

# Origens do frontend permitidas pelo CORS, separadas por vírgula
# CORS_ORIGIN=https://app.exemplo.com.br

# Número de proxies reversos à frente da API (Nginx, Render, Railway...)
# TRUST_PROXY=1

# Em produção: oculta stack trace nas respostas de erro
# NODE_ENV=production
